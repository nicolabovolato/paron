---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { Zoom } from "starlight-image-zoom/components";

interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  alt: string;
  caption?: string;
  loading?: "eager" | "lazy";
  widths?: number[];
  sizes?: string;
  zoom?: boolean;
  density?: number;
}

const {
  light,
  dark,
  alt,
  caption,
  loading = "lazy",
  widths = [720, 1080, 1440, 2160],
  sizes = "(min-width: 72rem) 46rem, 100vw",
  zoom = true,
  density = 2,
} = Astro.props;
const images = [
  { theme: "light", src: light },
  { theme: "dark", src: dark },
];
---

<figure class="screenshot not-content">
  {images.map(({ theme, src }) => (
    <div class={theme}>
      {zoom ? (
        <Zoom label={alt}>
          <Image
            {src}
            {alt}
            width={Math.round(src.width / density)}
            densities={[1, density]}
            {loading}
            decoding="async"
          />
        </Zoom>
      ) : (
        <Image {src} {alt} {widths} {sizes} {loading} decoding="async" />
      )}
    </div>
  ))}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .screenshot {
    margin-block: 1.5rem;
  }
  .screenshot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.75rem;
    box-shadow:
      0 1px 2px oklch(0.2 0.02 40 / 0.06),
      0 12px 28px -14px oklch(0.2 0.02 40 / 0.28);
  }
  :global([data-theme="light"]) .screenshot .dark,
  :global([data-theme="dark"]) .screenshot .light {
    display: none;
  }
  figcaption {
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>
